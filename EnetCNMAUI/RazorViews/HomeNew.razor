    #region Favorites Loader

    private async Task LoadFavoritesAsync(bool append = false)
    {
        if (_favLoading || _user?.UserKey <= 0)
            return;

        _favLoading = true;
        _favLoadFailed = false;
        _favError = null;

        await InvokeAsync(StateHasChanged);

        try
        {
            var req = new OffersFavoriteRequest(_user.UserKey.ToString());
            var result = await apiService.GetFavoriteOffers(req);

            if (result?.Success == true)
            {
                _favoriteOffers = result.Data?.ToList() ?? new List<BusinessOfferItem>();
                await localCache.SaveItemInCache(HomeFavoritesCacheKey, _favoriteOffers);

                var favoriteIds = _favoriteOffers.Select(x => x.BusinessOffersKey).ToHashSet();

                foreach (var item in featuredOffers)
                    item.isFavorite = favoriteIds.Contains(item.BusinessOffersKey);

                foreach (var item in featuredOfferstop)
                    item.isFavorite = favoriteIds.Contains(item.BusinessOffersKey);
            }
            else
            {
                _favLoadFailed = true;
                _favError = result?.Message;
            }
        }
        catch (Exception ex)
        {
            _favLoadFailed = true;
            _favError = ex.Message;
        }
        finally
        {
            _favLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

