<!-- =============== /Card ================== -->
@code
{
    #region Parameters

    [Parameter, EditorRequired]
    public BusinessItem item { get; set; } = null!;

    // [Parameter, EditorRequired]
    // public bool IsGridView { get; set; }


    #endregion

    #region Navigation

    private async Task OnItemCardClick(BusinessItem item)
    {
       // var ite = IsGridView;
        var route = RouteHelper.BuildRoute(nameof(BusinessProfilePage),
          new Dictionary<string, string>
          {
                { "BusinessKeyweb", $"{item.BusinessKey},{item.Name}" }
          });

        await localCache.SaveItemInCache(LocalCacheKeys.BusinessItem(item.BusinessKey), item);

        await Shell.Current.GoToAsync(route);
    }
    private string GetBusinessTitle(BusinessItem item)
    {
        var type = item.GetType();

        return type.GetProperty("Name")?.GetValue(item)?.ToString()
            ?? type.GetProperty("BusinessName")?.GetValue(item)?.ToString()
            ?? type.GetProperty("Title")?.GetValue(item)?.ToString()
            ?? "Business";
    }

    private string GetBusinessLocation(BusinessItem item)
    {
        var type = item.GetType();

        return type.GetProperty("City")?.GetValue(item)?.ToString()
            ?? type.GetProperty("Location")?.GetValue(item)?.ToString()
            ?? type.GetProperty("Address")?.GetValue(item)?.ToString()
            ?? "Ventura, CA";
    }

    private string GetBusinessImage(BusinessItem item)
    {
        var type = item.GetType();

        return type.GetProperty("ImageUrl")?.GetValue(item)?.ToString()
            ?? type.GetProperty("Image")?.GetValue(item)?.ToString()
            ?? type.GetProperty("Logo")?.GetValue(item)?.ToString()
            ?? "images/pic-business01.jpg";
    }

    private string GetOfferCount(BusinessItem item)
    {
        var type = item.GetType();

        return type.GetProperty("ActiveOffersCount")?.GetValue(item)?.ToString()
            ?? type.GetProperty("OffersCount")?.GetValue(item)?.ToString()
            ?? "0";
    }
    #endregion
}
