                    </div>
                </div>

                <div class="col-md-3">
                    <h6 class="mb-3">Company</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="hover-underline-animation left">About Us</a></li>
                        <li><a href="#" class="hover-underline-animation left">Privacy Policy</a></li>
                        <li><a href="#" class="hover-underline-animation left">Get Full Access</a></li>
                        <li><a href="#" class="hover-underline-animation left">My Saving</a></li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <div class="footer-card-social">
                        <a href="#" class="fa-brands fa-instagram"></a>
                        <a href="#" class="fa-brands fa-facebook"></a>

                        <small class="d-block">We Accept Cards</small>
                        <img src="images/secure_payment.svg" alt="" />
                    </div>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="row py-3">
                <div class="copyright">
                    <div class="float-start">© 2026 All About Local, Inc. All Rights Reserved.</div>
                    <div class="float-end">
                        <a href="#" class="hover-underline-animation left">Terms of Use</a> |
                        <a href="#" class="hover-underline-animation left">Privacy Statement</a> |
                        <a href="#" class="hover-underline-animation left">Licenses</a> |
