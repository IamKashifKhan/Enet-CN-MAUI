    #region UI Helper Methods

    private string GetOfferHeading(BusinessOfferItem? offer)
    {
        if (offer == null)
            return "Featured Offer";

        if (!string.IsNullOrWhiteSpace(offer.Heading))
            return offer.Heading;

        if (!string.IsNullOrWhiteSpace(offer.BusinessName))
            return offer.BusinessName;

        return "Featured Offer";
    }

    private string GetOfferSubTitle(BusinessOfferItem? offer)
    {
        if (offer == null)
            return "Featured";

        if (!string.IsNullOrWhiteSpace(offer.BusinessName))
            return offer.BusinessName;

        if (!string.IsNullOrWhiteSpace(offer.Description))
            return offer.Description.Length > 40
                ? offer.Description[..40] + "..."
                : offer.Description;

        return $"Views {offer.OfferViews}";
    }

    private string GetOfferImage(BusinessOfferItem? offer)
    {
        if (offer == null)
            return "images/pic-health.jpg";

        if (!string.IsNullOrWhiteSpace(offer.ThumbnailPath))
            return offer.ThumbnailPath;

        if (!string.IsNullOrWhiteSpace(offer.ImagePath))
            return offer.ImagePath;

        if (!string.IsNullOrWhiteSpace(offer.BusinessProfileImagePath))
            return offer.BusinessProfileImagePath;

        if (!string.IsNullOrWhiteSpace(offer.BusinessLogoPath))
            return offer.BusinessLogoPath;

        return "images/pic-health.jpg";
    }

    private string GetBusinessImage(BusinessOfferItem? offer)
    {
        if (offer == null)
            return "images/pic-business01.jpg";

        if (!string.IsNullOrWhiteSpace(offer.BusinessProfileImagePath))
            return offer.BusinessProfileImagePath;

        if (!string.IsNullOrWhiteSpace(offer.BusinessLogoPath))
            return offer.BusinessLogoPath;

        if (!string.IsNullOrWhiteSpace(offer.ThumbnailPath))
            return offer.ThumbnailPath;

        if (!string.IsNullOrWhiteSpace(offer.ImagePath))
            return offer.ImagePath;

        return "images/pic-business01.jpg";
    }

    private string GetRedemptionImage(RedemptionsItem? item)
    {
        try
        {
            if (item == null)
                return "images/pic-dinner.jpg";

            var imagePathProp = item.GetType().GetProperty("ImagePath");
            if (imagePathProp != null)
            {
                var imagePath = imagePathProp.GetValue(item)?.ToString();
                if (!string.IsNullOrWhiteSpace(imagePath))
                    return imagePath;
            }

            var thumbnailProp = item.GetType().GetProperty("ThumbnailPath");
            if (thumbnailProp != null)
            {
                var thumbnail = thumbnailProp.GetValue(item)?.ToString();
                if (!string.IsNullOrWhiteSpace(thumbnail))
                    return thumbnail;
            }
        }
        catch
        {
        }

        return "images/pic-dinner.jpg";
    }

    private string GetRedemptionHeading(RedemptionsItem? item)
    {
        try
        {
            if (item == null)
                return "Redeemed Offer";

            var headingProp = item.GetType().GetProperty("Heading");
            if (headingProp != null)
            {
                var heading = headingProp.GetValue(item)?.ToString();
                if (!string.IsNullOrWhiteSpace(heading))
                    return heading;
            }

            var nameProp = item.GetType().GetProperty("Name");
            if (nameProp != null)
            {
                var name = nameProp.GetValue(item)?.ToString();
                if (!string.IsNullOrWhiteSpace(name))
                    return name;
            }
        }
        catch
        {
        }

        return "Redeemed Offer";
    }

    private string GetRedemptionDescription(RedemptionsItem? item)
    {
        try
        {
            if (item == null)
                return "Recently redeemed";

            var descProp = item.GetType().GetProperty("Description");
            if (descProp != null)
            {
                var desc = descProp.GetValue(item)?.ToString();
                if (!string.IsNullOrWhiteSpace(desc))
                    return desc;
            }

            var businessProp = item.GetType().GetProperty("BusinessName");
            if (businessProp != null)
            {
                var business = businessProp.GetValue(item)?.ToString();
                if (!string.IsNullOrWhiteSpace(business))
                    return business;
            }
        }
        catch
        {
        }

        return "Recently redeemed";
    }

    private int GetRedemptionCount(RedemptionsItem? item)
    {
        try
        {
            if (item == null)
                return 0;

            var prop = item.GetType().GetProperty("RedemptionsCount");
            if (prop != null && int.TryParse(prop.GetValue(item)?.ToString(), out var count))
                return count;
        }
        catch
        {
        }

        return 0;
    }

    private int GetRedemptionViews(RedemptionsItem? item)
    {
        try
        {
            if (item == null)
                return 0;

            var prop = item.GetType().GetProperty("OfferViews");
            if (prop != null && int.TryParse(prop.GetValue(item)?.ToString(), out var count))
                return count;
        }
        catch
        {
        }

        return 0;
    }

    #endregion

    private async Task LoadFavoritesAsync(bool append = false)
    {
        if (_favLoading) return;

        _favLoading = true;
        _favLoadFailed = false;
        _favError = null;
        StateHasChanged();

        try
        {
            var req = new OffersFavoriteRequest(App.CurrentUser.UserKey.ToString());
            var result = await apiService.GetFavoriteOffers(req);

            if (result.Success)
            {
                var incoming = result.Data;
                _favoriteOffers = incoming.ToList();
            }
            else
            {
                _favLoadFailed = true;
                _favError = result.Message;
            }
        }
        catch (Exception ex)
        {
            _favLoadFailed = true;
            _favError = ex.Message;
        }
        finally
        {
            _favLoading = false;
            StateHasChanged();
        }
    }

    
}