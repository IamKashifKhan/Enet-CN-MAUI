    private async Task AddRemoveFav(BusinessOfferItem offer)
    {
        if (_favBusy || offer is null || _user?.UserKey <= 0)
            return;

        _favBusy = true;

        try
        {
            var response = await offerService.ToggleOfferFavoriteAsync(offer.BusinessOffersKey, _user.UserKey);

            if (response.Success)
            {
                var existingFav = _favoriteOffers.FirstOrDefault(x => x.BusinessOffersKey == offer.BusinessOffersKey);

                if (existingFav is not null)
                {
                    _favoriteOffers.RemoveAll(x => x.BusinessOffersKey == offer.BusinessOffersKey);
                    UpdateFavoriteStateAcrossLists(offer.BusinessOffersKey, false);
                }
                else
                {
                    offer.isFavorite = true;
                    _favoriteOffers.Insert(0, offer);
                    UpdateFavoriteStateAcrossLists(offer.BusinessOffersKey, true);
                }

                await localCache.SaveItemInCache(HomeFavoritesCacheKey, _favoriteOffers);
            }
        }
        catch
        {
        }
        finally
        {
            _favBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateFavoriteStateAcrossLists(long businessOffersKey, bool isFavorite)
    {
        foreach (var item in featuredOffers.Where(x => x.BusinessOffersKey == businessOffersKey))
            item.isFavorite = isFavorite;

        foreach (var item in featuredOfferstop.Where(x => x.BusinessOffersKey == businessOffersKey))
            item.isFavorite = isFavorite;

        if (SelectedOffer?.BusinessOffersKey == businessOffersKey)
            SelectedOffer.isFavorite = isFavorite;
    }

