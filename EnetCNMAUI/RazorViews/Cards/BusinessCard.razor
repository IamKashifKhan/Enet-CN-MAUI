@using EnetCNMAUI.Views
@inject ILocalCache localCache

<!-- ================= Card ================= -->


<div class="business-item">
    <div class="business-header">
        <a href="#" @onclick="@(async () => await OnItemCardClick(item))"  class="d-flex align-items-center gap-3">
            <img src="@item.ProfileImagePath" class="biz-img" alt="@GetBusinessTitle(item)">

            <div class="accordion-businesses">
                <h6 class="text-truncate">@GetBusinessTitle(item)</h6>
                <p class="location">
                    <lord-icon src="https://cdn.lordicon.com/onmwuuox.json" trigger="loop" delay="2000" colors="primary:#ff9935,secondary:#ff9935"></lord-icon>
                    @GetBusinessLocation(item)
                </p>
                <p class="offers">
                    <lord-icon src="https://cdn.lordicon.com/ytklkgsc.json" trigger="loop" delay="2000" colors="primary:#ff9935,secondary:#ff9935"></lord-icon>
                    @GetOfferCount(item) Offers
                </p>
            </div>
        </a>

        <div class="arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="#222" stroke-width="2">
                <polyline points="9 6 15 12 9 18" />
            </svg>
        </div>
    </div>

    <div class="business-body">
        <div class="owl-carousel redeemed-slider">
            <div class="card border-0 shadow-sm card-hover py-1">
                <div class="card-img rounded-4" style="background-image: url('@item.ProfileImagePath');"></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="fw-semibold mb-0">@GetBusinessTitle(item)</h6>
                        <span class="heart"><i class="fa-regular fa-heart"></i></span>
                    </div>
                    <p class="small">@GetBusinessLocation(item)</p>
                    <div class="d-flex gap-3 offers-icons">
                        <small>
                            <lord-icon src="https://cdn.lordicon.com/ytklkgsc.json" trigger="loop" delay="2000" colors="primary:#ff9935,secondary:#ff9935"></lord-icon>
                            <span class="view_num">@GetOfferCount(item)</span> <span class="view_txt">Offers</span>
                        </small>
                        <small>
                            <lord-icon src="https://cdn.lordicon.com/dicvhxpz.json" trigger="loop" delay="2000" colors="primary:#ff9935,secondary:#ff9935"></lord-icon>
                            <span class="view_num">0</span> <span class="view_txt">Views</span>
                        </small>
                        <button class="btn btn-primary btn-sm px-3 ms-auto">View</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
