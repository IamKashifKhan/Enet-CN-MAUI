            // categoryOffers = new List<BusinessOfferItem>();
        }
    }
    private async Task SearchOfferByText(string categoryKey, string count = "10")
    {
        try
        {
            var request = new OffersSearchRequest(
                App.CurrentUser.UserKey.ToString(),
                categoryKey,
                count);
            
            var output = await apiService.GetOffersSearch(request);
            
            if (output.Success && output.Data != null)
            {
                categoryOffers = output.Data;
            }
            else
            {
                categoryOffers = new List<BusinessOfferItem>();
            }
            
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching category offers: {ex.Message}");
            categoryOffers = new List<BusinessOfferItem>();
        }
    }


    #endregion

    #region Navigation

    private async Task HandleSelectedCategory(CategoryItem categoryItem)
    {
        if (categoryItem.Category_Sub_Key == CategoryKey)
            return;

        CategoryKey = categoryItem.Category_Sub_Key;
        CategoryName = categoryItem.Name;

        businessList?.Clear();
        await InvokeAsync(StateHasChanged);
        await GetBusiness(categoryItem.Category_Sub_Key);
        await InvokeAsync(StateHasChanged);
    }

    public async void GoBack()
    {
        await Shell.Current.GoToAsync("..");
    }

    private async void HandleCategorySelected(CategoryItem categoryItem)
    {
        if (categoryItem.Category_Sub_Key == CategoryKey)
            return;

        CategoryKey = categoryItem.Category_Sub_Key;
        businessList?.Clear();
        await InvokeAsync(StateHasChanged);
        await GetBusiness(categoryItem.Category_Sub_Key);
    }

    private void ToggleScreen(bool showOffers)
    {
        ShowOffers = showOffers;
    }

    #endregion

    #region Helpers

    private string GetCategoryIcon(CategoryItem cat)
    {
        var name = cat?.Name?.Trim().ToLowerInvariant() ?? string.Empty;

        if (name.Contains("bogo")) return "images/icon-bogo.svg";
        if (name.Contains("perk")) return "images/icon-perk.svg";
        if (name.Contains("health")) return "images/icon-health.svg";
        if (name.Contains("travel")) return "images/icon-travel.svg";
        if (name.Contains("entertainment")) return "images/icon-entertainment.svg";
        if (name.Contains("house") || name.Contains("home")) return "images/icon-home.svg";
        if (name.Contains("kid")) return "images/icon-kids.svg";
        if (name.Contains("pet")) return "images/icon-pet.svg";
        if (name.Contains("care") || name.Contains("beauty")) return "images/icon-care.svg";
        if (name.Contains("automotive") || name.Contains("car")) return "images/icon-automotive.svg";
        if (name.Contains("shop")) return "images/icon-shops.svg";
        if (name.Contains("eat") || name.Contains("dining") || name.Contains("restaurant")) return "images/icon-eat.svg";
        if (name.Contains("drink") || name.Contains("wine")) return "images/icon-drink.svg";
        if (name.Contains("business")) return "images/icon-business.svg";

        return "images/icon-business.svg";
    }

    private string GetBusinessTitle(BusinessItem item)
    {
        var type = item.GetType();

        return type.GetProperty("Name")?.GetValue(item)?.ToString()
            ?? type.GetProperty("BusinessName")?.GetValue(item)?.ToString()
            ?? type.GetProperty("Title")?.GetValue(item)?.ToString()
            ?? "Business";
    }

    private string GetBusinessLocation(BusinessItem item)
    {
        var type = item.GetType();

        return type.GetProperty("City")?.GetValue(item)?.ToString()
            ?? type.GetProperty("Location")?.GetValue(item)?.ToString()
            ?? type.GetProperty("Address")?.GetValue(item)?.ToString()
            ?? "Ventura, CA";
    }

    private string GetBusinessImage(BusinessItem item)
    {
        var type = item.GetType();

        return type.GetProperty("ImageUrl")?.GetValue(item)?.ToString()
            ?? type.GetProperty("Image")?.GetValue(item)?.ToString()
            ?? type.GetProperty("Logo")?.GetValue(item)?.ToString()
            ?? "images/pic-business01.jpg";
    }

    private string GetOfferCount(BusinessItem item)
    {
        var type = item.GetType();

        return type.GetProperty("ActiveOffersCount")?.GetValue(item)?.ToString()
            ?? type.GetProperty("OffersCount")?.GetValue(item)?.ToString()
            ?? "0";
    }

    private string GetOfferImage(BusinessOfferItem? offer)
    {
        if (offer == null)
            return "images/pic-dinner.jpg";

        if (!string.IsNullOrWhiteSpace(offer.ThumbnailPath))
            return offer.ThumbnailPath;

        if (!string.IsNullOrWhiteSpace(offer.ImagePath))
            return offer.ImagePath;

        if (!string.IsNullOrWhiteSpace(offer.BusinessProfileImagePath))
            return offer.BusinessProfileImagePath;

        if (!string.IsNullOrWhiteSpace(offer.BusinessLogoPath))
            return offer.BusinessLogoPath;

        return "images/pic-dinner.jpg";
    }

    private string GetOfferHeading(BusinessOfferItem? offer)
    {
        if (offer == null)
            return "Offer";

        if (!string.IsNullOrWhiteSpace(offer.Heading))
            return offer.Heading;

        if (!string.IsNullOrWhiteSpace(offer.BusinessName))
            return offer.BusinessName;

        return "Offer";
    }

    private string GetOfferSubTitle(BusinessOfferItem? offer)
    {
        if (offer == null)
            return "Available";

        if (!string.IsNullOrWhiteSpace(offer.BusinessName))
            return offer.BusinessName;

        if (!string.IsNullOrWhiteSpace(offer.Description))
            return offer.Description.Length > 40
                ? offer.Description[..40] + "..."
                : offer.Description;

        return $"Views {offer.OfferViews}";
    }

    private async Task OpenOfferAsync(BusinessOfferItem offer)
    {
        if (offer == null)
            return;

        SelectedOffer = offer;
        Code = string.Empty;
        StateHasChanged();
        
        await jSRuntime.InvokeVoidAsync("eval", "const offcanvas = new bootstrap.Offcanvas(document.getElementById('offcanvasRedeem')); offcanvas.show();");
    }

    #endregion

    #region Offer Redeem / Modal State

    private BusinessOfferItem? SelectedOffer = new();
    public string Code { get; set; } = string.Empty;
    private bool _favBusy;

    #endregion

    #region Redeem Methods

    private async Task ValidateCode()
    {
        if (SelectedOffer == null || string.IsNullOrWhiteSpace(Code))
            return;

        var redeedmOfferRequest = new RedeemOfferRequest(
            App.CurrentUser.UserKey.ToString(),
            SelectedOffer.BusinessOffersKey.ToString(),
            Code);

        var output = await apiService.RedeemOffer(redeedmOfferRequest);

        if (output.Success)
        {
            await jSRuntime.InvokeVoidAsync("eval", "$('#modalRedeemCode').modal('hide');");
            await Task.Delay(300);
            await jSRuntime.InvokeVoidAsync("eval", "const modal = new bootstrap.Modal(document.getElementById('modalRedeemSuccess')); modal.show();");
        }
    }

    private async Task ToggleFavorite(BusinessOfferItem? offer)
    {
        if (offer == null || _favBusy)
            return;

        _favBusy = true;

        try
        {
            var response = await offerService.ToggleOfferFavoriteAsync(offer.BusinessOffersKey, App.CurrentUser.UserKey);

            if (response.Success)
            {
                offer.isFavorite = !offer.isFavorite;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
        }
        finally
        {
            _favBusy = false;
        }
    }

    private async Task GotoSavingsPage()
    {
        await Shell.Current.GoToAsync(nameof(MySavingsPage));
    }

    #endregion
