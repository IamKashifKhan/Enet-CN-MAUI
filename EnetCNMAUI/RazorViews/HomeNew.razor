        if (_favBusy)
            return;

        _favBusy = true;

        try
        {
            var response = await offerService.ToggleOfferFavoriteAsync(offer.BusinessOffersKey, _user.UserKey);

            if (response.Success)
                _favoriteOffers.RemoveAll(o => o.BusinessOffersKey == offer.BusinessOffersKey);
        }
        catch
        {
        }
        finally
        {
            _favBusy = false;
            StateHasChanged();
        }
