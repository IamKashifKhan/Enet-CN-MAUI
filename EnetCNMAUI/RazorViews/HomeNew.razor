<section class="container mt-5 redeemed-offers">
    <div class="d-flex justify-content-between mb-3">
        <h5 class="main-heading text-truncate">Featured</h5>
        <small class="see-all">
            <a href="#" class="hover-underline-animation left">See All <i class="fa-solid fa-chevron-right"></i></a>
        </small>
    </div>

    <div class="redeemed-wrapper">
        @if (featuredOfferstop != null && featuredOfferstop.Any())
        {
            <div class="owl-carousel redeemed-slider">
                @foreach (var offer in featuredOfferstop)
                {
                    <div class="card border-0 shadow-sm card-hover py-1">
                        <div class="card-img rounded-4" style="background-image: url('@GetOfferImage(offer)');"></div>
                        <div class="card-body">
                            <h6>@GetOfferHeading(offer)</h6>
                            <p class="small">@GetOfferSubTitle(offer)</p>

                            <div class="d-flex gap-3 offers-icons">
                                <small>
                                    <lord-icon src="https://cdn.lordicon.com/ytklkgsc.json"
                                               trigger="loop"
                                               delay="2000"
                                               colors="primary:#ff9935,secondary:#ff9935">
                                    </lord-icon>
                                    <span class="view_num">@offer.RedemptionsCount</span>
                                    <span class="view_txt">Redemptions</span>
                                </small>

                                <small>
                                    <lord-icon src="https://cdn.lordicon.com/dicvhxpz.json"
                                               trigger="loop"
                                               delay="2000"
                                               colors="primary:#ff9935,secondary:#ff9935">
                                    </lord-icon>
                                    <span class="view_num">@offer.OfferViews</span>
                                    <span class="view_txt">Views</span>
                                </small>

                                <button class="btn btn-primary btn-sm px-3 ms-auto"
                                        @onclick="async () => await OpenFeaturedOfferAsync(offer)">
                                    Redeem Now
                                </button>
                            </div>
                        </div>
                    </div>

                }
        
            </div>
        }
        else if (isRedemptionsLoading)
        {
            <div class="text-muted">Loading redemptions...</div>
        }
        else
        {
            <div class="text-muted">No redeemed offers available.</div>
        }
    </div>
</section>

