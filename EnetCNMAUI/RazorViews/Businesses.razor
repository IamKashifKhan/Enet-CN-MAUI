@using EnetCNMAUI.Views
@using EnetCNMAUI.Domain.Models.MVC

@inject ILocalCache localCache
@inject ICNApiService apiService
@inject ILoginService loginService
@inject IThemeManager themeManager
@inject IJSRuntime jSRuntime
@inject IOfferService offerService
@using EnetCNMAUI.Services.Local


<div class="d-flex flex-column business-page-new">

    <!-- Filter Business -->
    <!-- Filter Offer -->
    <div class="offcanvas offcanvas-top h-100 border-0" tabindex="-1" id="filterOffer" aria-labelledby="filterLabel">
        <div class="offcanvas-header px-4 pt-4 pb-2">
            <h5 class="offcanvas-title section-title" id="filterLabel">
                <i class="fa-solid fa-sliders"></i> Filters - Offer
            </h5>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body px-4">
            <!-- Selected Tags Section -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div id="selectedTags" class="d-flex flex-wrap gap-2">
                    <!-- JS tags  -->
                </div>
                <button id="clearAll" class="btn-clear-all p-0">Clear All</button>
            </div>

            <hr class="divider-line">

            <!-- sorting -->
            <div class="mt-4">
                <h6 class="section-title">Listing Sort By</h6>
                <div class="tags-group d-flex flex-wrap gap-2 mt-3">
                    <div class="filter-tag">
                        <input type="checkbox" id="food" value="Newest">
                        <label for="Newest">Newest</label>
                    </div>
                    <div class="filter-tag">
                        <input type="checkbox" id="pet" value="Oldest">
                        <label for="Oldest">Oldest</label>
                    </div>
           
                </div>
            </div>

	  
            <!-- Sub Categories -->
            <div class="mt-4">
                <h6 class="section-title">Sub Categories</h6>
                <div class="tags-group d-flex flex-wrap gap-2 mt-3">
                    <div class="filter-tag">
                        <input type="checkbox" id="food" value="FOOD">
                        <label for="food">Food</label>
                    </div>
                    <div class="filter-tag">
                        <input type="checkbox" id="pet" value="PET" checked>
                        <label for="pet">Pet</label>
                    </div>
                    <div class="filter-tag">
                        <input type="checkbox" id="movies" value="MOVIES">
                        <label for="movies">Movies</label>
                    </div>
                    <div class="filter-tag">
                        <input type="checkbox" id="wine" value="WINE">
                        <label for="wine">Wine</label>
                    </div>
                </div>
            </div>

     
            <!-- Sub Categories -->
            <div class="mt-4">
                <h6 class="section-title">Top Redeemed Offers</h6>
                <div class="tags-group d-flex flex-wrap gap-2 mt-3">
                    <div class="filter-tag">
                        <input type="checkbox" id="yes" value="Yes">
                        <label for="yes">Yes</label>
                    </div>
                    <div class="filter-tag">
                        <input type="checkbox" id="no" value="No">
                        <label for="no">NO</label>
                    </div>
            
                </div>
            </div>

            <!-- Nearby Range -->
            <h5 class="section-title mt-4">Nearby Range</h5>
            <div class="range-wrapper">
                <div class="d-flex justify-content-between">
                    <span>0.5mi</span>
                    <span>10mi</span>
                </div>

                <input type="range" min="0" max="10" step="0.1" value="3.5"
                       class="form-range custom-range" id="distanceRange">

                <div class="text-center mt-2">
                    <span id="rangeValue">3.5</span>mi
                </div>
            </div>

    
            <!-- Button -->
            <div class="text-center mt-4">
                <button class="btn filter-btn">Filter Now</button>
            </div>
        </div>
    </div>

    <!-- Search Offcanvas -->
    <div class="offcanvas offcanvas-top h-100" tabindex="-1" id="offcanvasFullscreen" aria-labelledby="offcanvasFullscreenLabel">
        <div class="offcanvas-body">
            <div class="search-wrapper">

                <div class="search-bar d-flex align-items-center mb-4">
                    <span class="search-icon">
                        <lord-icon src="https://cdn.lordicon.com/wjyqkiew.json" trigger="loop" delay="2000" colors="primary:#121331,secondary:#ff9935" class="top-icon-animated"></lord-icon>
                    </span>
                    <input type="text" class="form-control border-0" placeholder="Search for Offer / Food / Beauty etc.">
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>

                <h5 class="section-title">Popular Categories</h5>
                <div class="row text-center g-3 categories">
                    <div class="owl-carousel categories-slider top-categories">
                        @if (mainCategories != null && mainCategories.Count > 0)
                        {
                            foreach (var item in mainCategories)
                            {
                                <div class="cat-item">
                                    <a href="" class="hover-underline-animation center" @onclick="@(async () => await HandleSelectedCategory(item))" @onclick:preventDefault>
                                        <img src="@GetCategoryIcon(item)" alt="@item.Name">
                                        <p>@item.Name</p>
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>

                <h5 class="section-title mt-4">Recent Search</h5>
                <ul class="recent-search list-unstyled">
                    <li><a href="#"><i class="fa-solid fa-clock-rotate-left"> <small>Plumber</small></i></a><span class="remove-item"><i class="fa-solid fa-xmark"></i></span></li>
                    <li><a href="#"><i class="fa-solid fa-clock-rotate-left"> <small>Burger</small></i></a><span class="remove-item"><i class="fa-solid fa-xmark"></i></span></li>
                    <li><a href="#"><i class="fa-solid fa-clock-rotate-left"> <small>Pet Food</small></i></a><span class="remove-item"><i class="fa-solid fa-xmark"></i></span></li>
                    <li><a href="#"><i class="fa-solid fa-clock-rotate-left"> <small>Movie</small></i></a><span class="remove-item"><i class="fa-solid fa-xmark"></i></span></li>
                </ul>

                <h5 class="section-title mt-4">Popular Businesses</h5>
                <div class="row g-3 offer-cards">
                    <div class="owl-carousel offers-slider">
                        @if (businessList != null && businessList.Count > 0)
                        {
                            foreach (var item in businessList.Take(8))
                            {
                                <div class="item">
                                    <div class="card custom-card">
                                        <a href="#" class="hover-underline-animation">
                                            <img src="@item.ProfileImagePath" class="card-img-top" alt="@GetBusinessTitle(item)">
                                            <div class="card-body">
                                                <h6>@GetBusinessTitle(item)</h6>
                                                <small>Nearby 5mi</small>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="item">
                                <div class="card custom-card">
                                    <img src="images/pic-business01.jpg" class="card-img-top" alt="">
                                    <div class="card-body">
                                        <h6>Popular Business</h6>
                                        <small>Nearby 5mi</small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <h5 class="section-title mt-4">Nearby Range</h5>
                <div class="range-wrapper">
                    <div class="d-flex justify-content-between">
                        <span>0.5mi</span>
                        <span>10mi</span>
                    </div>

                    <input type="range" min="0" max="10" step="0.1" value="3.5" class="form-range custom-range">
                    <div class="text-center mt-2"><span>3.5</span>mi</div>
                </div>

                <div class="text-center mt-4">
                    <button class="btn filter-btn">Filter Now</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Header -->
    <div id="mob_top" class="container inner-header mt-3 bg-white d-flex d-lg-none sticky-sm-top-only">
        <div class="row w-100">
            <div class="d-flex justify-content-between align-items-center w-100">
                <h4 class="mb-0 fw-semibold text-truncate">
                    <a @onclick="() => GoBack()"
                           href=""
                           class="back-link"
                           @onclick:preventDefault>
                        <span class="back-arrow me-3">
                            <i class="fa-solid fa-angle-left"></i>
                        </span>
                    </a>
                    @DisplayHeaderTitle
                </h4>
            </div>
        </div>
    </div>

    <!-- Categories -->
    <section class="bg-white pt-3 pb-2">
        <div class="container">
            <div class="owl-carousel categories-slider top-categories" id="owl-tabs">
                @if (mainCategories != null && mainCategories.Count > 0)
                {
                    foreach (var item in mainCategories)
                    {
                        <div class="cat-item">
                            <a href="" class="hover-underline-animation center" @onclick="@(async () => await HandleSelectedCategory(item))" @onclick:preventDefault>
                                <img src="@GetCategoryIcon(item)" alt="@item.Name">
                                <p>@item.Name</p>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="loading">
                        <div></div>
                        <div></div>
                        <div></div>
                        <div></div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <div class="container border-top pt-3">
        <div class="row">

            <!-- Toggle + Filter + Sort -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="toggle-wrapper">
                    <button class="@(ShowOffers ? "active" : "")" @onclick="() => ToggleScreen(true)">Offers</button>
                    <button class="@(!ShowOffers ? "active" : "")" @onclick="() => ToggleScreen(false)">Businesses</button>
                </div>

                <div class="d-flex align-items-center gap-2 filter-sort-bar">
                    <a href="#" class="filter-link" data-bs-toggle="offcanvas" data-bs-target="#filterOffer"><i class="fa-solid fa-sliders"></i></a>
                </div>
            </div>

            <!-- Offers Screen -->
            <div id="offersScreen" class="@(ShowOffers ? "" : "hidden")">
                <div class="offersWrap">

                    @if (categoryOffers != null && categoryOffers.Any())
                    {
                        foreach (var offer in categoryOffers)
                        {
                            <div class="card card-hover border-0 shadow-sm py-1">
                                <div class="card-img rounded-4" style="background-image: url('@GetOfferImage(offer)');"></div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6 class="fw-semibold mb-0">@GetOfferHeading(offer)</h6>
                                        <span class="heart"><i class="fa-regular fa-heart"></i></span>
                                    </div>
                                    <p class="small">@GetOfferSubTitle(offer)</p>
                                    <div class="d-flex gap-3 offers-icons">
                                        <small>
                                            <lord-icon src="https://cdn.lordicon.com/ytklkgsc.json" trigger="loop" delay="2000" colors="primary:#ff9935,secondary:#ff9935"></lord-icon>
                                            <span class="view_num">@offer.RedemptionsCount</span> <span class="view_txt">Redemptions</span>
                                        </small>
                                        <small>
                                            <lord-icon src="https://cdn.lordicon.com/dicvhxpz.json" trigger="loop" delay="2000" colors="primary:#ff9935,secondary:#ff9935"></lord-icon>
                                            <span class="view_num">@offer.OfferViews</span> <span class="view_txt">Views</span>
                                        </small>
                                        <button class="btn btn-primary btn-sm px-3 ms-auto" @onclick="async () => await OpenOfferAsync(offer)">Redeem Now</button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <p class="text-muted">No offers available for this category.</p>
                        </div>
                    }

                    <div class="card card-suggested">
                        <div class="d-flex justify-content-between mb-2">
                            <h5 class="fw-semibold m-0">Suggested Restaurants</h5>
                            <small class="see-all mt-1">
                                <a href="#" class="hover-underline-animation left">See All <i class="fa-solid fa-chevron-right"></i></a>
                            </small>
                        </div>

                        <div class="owl-carousel suggested-slider">
                            @if (businessList != null && businessList.Count > 0)
                            {
                                foreach (var group in businessList.Chunk(2).Take(4))
                                {
                                    <div class="item">
                                        <div class="suggested-column">
                                            @foreach (var item in group)
                                            {
                                                <a href="#" class="suggested-link">
                                                    <div class="suggested-card">
                                                        <img src="@item.ProfileImagePath" alt="@GetBusinessTitle(item)">
                                                        <div>
                                                            <h6 class="text-truncate">@GetBusinessTitle(item)</h6>
                                                            <p class="location"><i class="fa-solid fa-location-dot"></i>@GetBusinessLocation(item)</p>
                                                            <span class="badge-offer">@GetOfferCount(item) Offers</span>
                                                        </div>
                                                    </div>
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Business Screen -->
            <div id="businessScreen" class="@(!ShowOffers ? "" : "hidden")">
                <div class="business-accordion">

                    @if (businessList != null && businessList.Count > 0)
                    {
                        foreach (var item in businessList)
                        {
                            <BusinessCard item="item"></BusinessCard>
                        }
                    }
                    else
                    {
                        <LoadingCard></LoadingCard>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<!-- OffCanvas Redeem -->
<div id="offcanvasRedeem" class="offcanvas offcanvas-bottom h-1000" data-bs-scroll="false" tabindex="-1">
    <div class="offcanvas-header pt-4 pb-2">
        <h2 class="offcanvas-title">
            @SelectedOffer?.BusinessName
        </h2>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="offer-expiry">
                @if (SelectedOffer?.EndDate != default)
                {
                    @:Expiry @SelectedOffer?.EndDate.ToString("MM/dd/yyyy")
                }
            </div>
            <button class="heart d-inline-block ms-auto @(SelectedOffer?.isFavorite == true ? "active" : "")"
                    @onclick="@(async () => await ToggleFavorite(SelectedOffer))"
                    type="button"
                    data-bs-toggle="button">
                <i class="@(SelectedOffer?.isFavorite == true ? "fa-solid fa-heart" : "fa-regular fa-heart")"></i>
            </button>
        </div>
        <!-- Card Redeem -->
        <div class="card redeem">
            <h2 class="card-header">@SelectedOffer?.Heading</h2>
            <div class="card-body">
                <h5 class="redeem-desc">@SelectedOffer?.Description</h5>
                <p>Tap Redeem at checkout to display SKU number for cashier.</p>
                @if (!string.IsNullOrWhiteSpace(SelectedOffer?.ThumbnailPath))
                {
                    <div class="card-img" style="background-image: url('@SelectedOffer.ThumbnailPath');"></div>
                }
                <p>
                    This coupon is valid only at @(SelectedOffer?.BusinessName ?? "merchant").
                </p>
            </div>
            <div class="card-footer">
                <a href="#"
                   class="btn btn-primary px-5"
                   data-bs-toggle="modal"
                   data-bs-target="#modalRedeemCode"
                   @onclick:preventDefault>
                    Redeem Offer
                </a>
            </div>
        </div>
        <!-- /Card Redeem -->
    </div>
</div>

<!-- Modal Redeem Code -->
<div id="modalRedeemCode" class="modal fade" aria-labelledby="modalRedeemCode" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-body-emphasis">To Redeem this Offer</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Enter code @SelectedOffer?.ConfirmationCode to redeem offer at time of checkout</p>
                <input @bind="Code" class="form-control form-control-lg font-monospace" type="text" minlength="6" maxlength="6" placeholder="Enter Code" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" @onclick="ValidateCode" class="btn btn-primary" data-bs-toggle="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Redeem Success -->
<div id="modalRedeemSuccess" class="modal fade" aria-labelledby="modalRedeemSuccess" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-body-emphasis">Congrats..! Enjoy..!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>You have successfully redeemed this offer, thank for your shopping local!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="GotoSavingsPage" data-bs-dismiss="modal">SEE YOUR SAVINGS</button>
            </div>
        </div>
    </div>
</div>

@code {
    #region Parameters

    [Parameter]
    public string? CategoryId { get; set; }

    private bool IsGrid;
    private bool ShowOffers = true;
    private string SelectedSort = "Sort";

    #endregion

    #region Injected References

    private IJSObjectReference? businessesJsRefernce;
    private DotNetObjectReference<Businesses>? businessesDotnetReference;

    #endregion

    #region Data Models

    private List<CategoryItem>? mainCategories;
    private List<BusinessItem>? businessList;
    private List<BusinessOfferItem>? categoryOffers;  // New: Category-based offers
    private string CategoryName = string.Empty;
    private string CategoryKey = string.Empty;

    private string DisplayHeaderTitle => string.IsNullOrWhiteSpace(CategoryName) ? "" : CategoryName;

    #endregion

    #region Lifecycle Methods

    protected override async void OnInitialized()
    {
        businessesJsRefernce = await jSRuntime.InvokeAsync<IJSObjectReference>("import", "./RazorViews/Businesses.razor.js");
        await jSRuntime.InvokeVoidAsync("Helpers.setDotNetHelper", DotNetObjectReference.Create(this));

        businessesDotnetReference = DotNetObjectReference.Create(this);



        if (!string.IsNullOrWhiteSpace(CategoryId))
        {
            var DataArray = CategoryId.Split(',');

            if (DataArray[0] == "City")
            {
                GetCityBusiness(DataArray[1], string.Empty);
                await GetOffersByCity(DataArray[1]);
            }
            else if (DataArray[0] == "Search")
            {
                GetCityBusiness(string.Empty, DataArray[1]);
                await SearchOfferByText(DataArray[1]);
            }
            else
            {
                CategoryKey = DataArray[0];
                await GetBusiness(CategoryKey);
                await GetOffersByCategory(CategoryKey);  // Fetch category-based offers
                CategoryName = DataArray.Length > 1 ? DataArray[1] : string.Empty;
            }
        }

        GetMainCategories();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(1500);
            await SetupTabs();
        }
    }

    #endregion

    #region JS Setup

    private async Task SetupTabs()
    {
        if (businessesJsRefernce is null)
            return;

        // try
        // {
        //     await businessesJsRefernce.InvokeVoidAsync("owlCarouselstart");
        // }
        // catch { }

        // try
