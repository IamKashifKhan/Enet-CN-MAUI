<main class="flex-shrink-0 py-0"  >
    <div class="container-fluid">

      @*   <div role="tabpanel" class="tab-pane"
             hidden="@(selectedTab != NavTab.Directory ? "hidden" : null)"
             aria-hidden="@(selectedTab != NavTab.Directory ? "true" : "false")">
            <div class="row">
                @if (isCategoriesLoading)
                {
                    <div class="small text-muted d-flex align-items-center gap-2 mb-2">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        <span>Loading categories…</span>
                    </div>
                }
                <div class="d-flex flex-wrap gap-lg-4 category-boxes">
                    @if (mainCategories is not null)
                    {
                        foreach (var item in mainCategories)
                        {
                            <CategoryCard Category="item" OnSelected="HandleCategorySelected"></CategoryCard>
                        }
                    }
                </div>
            </div>
        </div> *@

        <div role="tabpanel" class="tab-pane"
              hidden="@(selectedTab != NavTab.Events ? "hidden" : null)"
              aria-hidden="@(selectedTab != NavTab.Events ? "true" : "false")">
            <div class="row">
                @if (_eventsLoadFailed)
                {
                    <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
                        <span>Failed to load events. @(_eventsError ?? "Please try again.")</span>
                        <button class="btn btn-sm btn-outline-light" @onclick="RetryEventsAsync">Retry</button>
                    </div>
                }
                @if (isEventsLoading)
                {
                    <div class="small text-muted d-flex align-items-center gap-2 mb-2">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        <span>Loading events…</span>
                    </div>
                }
                <ul class="card-group events-timeline">
                    @if (alleventItems is not null && alleventItems.Count > 0)
                    {
                        @foreach (var ev in alleventItems)
                        {
                            <EventCard Event="ev" OnSelected="HandleEventSelected" />
                        }
                    }
                    else if (!isEventsLoading && !_eventsLoadFailed)
                    {
                        <div class="map-offers-count">No events found nearby</div>
                    }
                </ul>
            </div>
        </div>

        <div role="tabpanel" class="tab-pane"
             hidden="@(selectedTab != NavTab.Favorites ? "hidden" : null)"
             aria-hidden="@(selectedTab != NavTab.Favorites ? "true" : "false")">
            <div class="row">
                <h1 class="d-none d-lg-block text-center fw-normal h1 mb-4">Favorites</h1>

                @if (_favLoading && _favoriteOffers.Count == 0)
                {
                    <div class="small text-muted d-flex align-items-center gap-2 mb-2">
                        <div class="spinner-border spinner-border-sm" role="status"></div>
                        <span>Loading favorites…</span>
                    </div>
                }

                @if (_favLoadFailed && !string.IsNullOrWhiteSpace(_favError))
                {
                    <div class="alert alert-danger">@_favError</div>
                }

                <ul class="card-group favorites">
                    @if (_favoriteOffers.Count == 0 && !_favLoading)
                    {
                        <li class="w-100 text-center py-4 text-muted">
                            No favorites yet.
                        </li>
                    }
                    else
                    {
                        @foreach (var offer in _favoriteOffers)
                        {
                            <OfferCard Offer="offer"
                                       isActivePlan="planDetails?.IsActive == true"
                                       OnSelected="HandleOfferSelected"
                                       AddRemoveToFavorite="AddRemoveFav" />
                        }
                    }
                </ul>
            </div>
        </div>

        <div role="tabpanel" class="tab-pane flex-shrink-0 map-main"
             hidden="@(selectedTab != NavTab.Map ? "hidden" : null)"
             aria-hidden="@(selectedTab != NavTab.Map ? "true" : "false")">
            <div class="container-fluid map-wrapper">
                <GoogleMap Width="100%" Height="100%" 
                           ApiKey="@MapConfig.GoogleMapsApiKey"
                           StartLat="StartLat"
                           StartLng="StartLng"
                           StartZoom="12"
                           CssClass="business-map"
                           OnViewChanged="OnMapChanged"
                           OnMapPinTapped="OnPinTapped"
                           @ref="_map" />
                <div class="maps-over justify-content-end">
                    <div class="slide-cards">
                        <button class="btn btn-secondary rounded-circle shadow-sm mb-5 btn-nearby" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNearby" aria-controls="offcanvasNearby">
                            <img src="img/nearby.svg" alt="" />
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>

<div class="@GetSectionVisibilityClass(NavTab.Home)">
    <section class="bg-white d-lg-none d-md-block">
        <div class="container border-bottom pt-3 pb-1">
            <div class="row row-cols-4 row-cols-sm-4 row-cols-lg-4 g-1 top-offers text-center">
                <div class="col">
                    <a href="#" @onclick="() => SelectTabAsync(NavTab.Directory)" @onclick:preventDefault class="hover-underline-animation center">
                        <img src="https://www.svgrepo.com/show/276618/badge-discount.svg">
                        <p>Deals</p>
                    </a>
                </div>

                <div class="col">
                    <a href="#" @onclick="() => SelectTabAsync(NavTab.Events)" @onclick:preventDefault class="hover-underline-animation center">
                        <img src="https://www.svgrepo.com/show/215200/badge-new.svg">
                        <p>Whats New?</p>
                    </a>
                </div>

                <div class="col">
                    <a href="#" @onclick="() => SelectTabAsync(NavTab.Favorites)" @onclick:preventDefault class="hover-underline-animation center">
                        <img src="https://www.svgrepo.com/show/397713/party-popper.svg">
                        <p>Celebrate</p>
                    </a>
                </div>

                <div class="col">
                    <a href="#" @onclick="() => SelectTabAsync(NavTab.Map)" @onclick:preventDefault class="hover-underline-animation center">
                        <img src="https://www.svgrepo.com/show/269440/placeholder-wedding.svg">
                        <p>Near Me</p>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-white pt-3 pb-2">
        <div class="container">
            @if (mainCategories?.Any() == true)
            {
                <div class="owl-carousel categories-slider top-categories">
                    @foreach (var cat in mainCategories)
                    {
                        <CategoryCapsule Category="cat" OnSelected="HandleCategorySelected" />
                    }
                </div>
            }
            else if (isCategoriesLoading)
            {
                <div class="text-muted">Loading categories...</div>
            }
        </div>
    </section>

    <section class="container mt-1 redeemed-offers">
        <div class="d-flex justify-content-between mb-3">
            <h5 class="main-heading text-truncate">Featured</h5>
            <small class="see-all">
                <a href="#" class="hover-underline-animation left">See All <i class="fa-solid fa-chevron-right"></i></a>
            </small>
        </div>

        <div class="redeemed-wrapper">
            @if (featuredOfferstop?.Any() == true)
            {
                <div class="owl-carousel redeemed-slider">
                    @foreach (var offer in featuredOfferstop)
                    {
                        <OfferCard Offer="offer"
                                   OnSelected="HandleOfferSelected"
                                   AddRemoveToFavorite="AddRemoveFav"
                                   isActivePlan="planDetails?.IsActive == true">
                        </OfferCard>
                    }
                </div>
            }
            else if (isFeaturedOffersLoading)
            {
                <div class="text-muted">Loading featured offers...</div>
            }
            else
            {
                <div class="text-muted">No featured offers available.</div>
            }
        </div>
    </section>

    <section class="container mt-4 redeemed-offers">
        <div class="d-flex justify-content-between mb-3">
            <h5 class="main-heading text-truncate">More around</h5>
            <small class="see-all">
                <a href="#" class="hover-underline-animation left">See All <i class="fa-solid fa-chevron-right"></i></a>
            </small>
        </div>

        <div class="redeemed-wrapper">
            @if (featuredOffers?.Any() == true)
            {
                <div class="owl-carousel featured-offers-slider">
                    @foreach (var offer in featuredOffers)
                    {
                        <OfferCard Offer="offer"
                                   OnSelected="HandleOfferSelected"
                                   AddRemoveToFavorite="AddRemoveFav"
                                   isActivePlan="planDetails?.IsActive == true">
                        </OfferCard>
                    }
                </div>
            }
            else if (isFeaturedOffersLoading)
            {
                <div class="text-muted">Loading featured offers...</div>
            }
            else
            {
                <div class="text-muted">No featured offers available.</div>
            }
        </div>
    </section>

    <div class="mt-5 pt-1 d-lg-none d-md-block"></div>

    <footer class="mt-5 d-xs-none d-sm-none d-md-none d-lg-block">
        <div class="container footer">
            <div class="row p-5">
                <div class="col-md-3 newsletter-subscription">
                    <h6 class="mb-3">Get Today's Top Offers</h6>
                    <div class="input-group mb-3">
                        <input type="email" class="form-control" placeholder="Email Address *">
                        <button class="btn btn-warning">Subscribe</button>
                    </div>
                    <div class="text-subscription">
                        Save every day by signing up for All About Local newsletter. By signing up, you agree to All About Local terms of service and privacy policy You may unsubscribe from the newsletters at any time.
                    </div>
                </div>

                <div class="col-md-3">
                    <h6 class="mb-3">Get savings on the go!</h6>
                    <div class="gap-2 app-stores">
                        <a href="#"><img src="images/App_Store.svg" alt="" /></a>
