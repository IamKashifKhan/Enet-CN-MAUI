<div id="offcanvasRedeem" class="offcanvas offcanvas-bottom h-1000" data-bs-scroll="false" tabindex="-1">
    <div class="offcanvas-header pt-4 pb-2">
        <h2 class="offcanvas-title">
            @SelectedOffer?.BusinessName
        </h2>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="offer-expiry">
                @if (SelectedOffer is not null && SelectedOffer.EndDate != default)
                {
                    @:Expiry @SelectedOffer.EndDate.ToString("MM/dd/yyyy")
                }
            </div>

            <button class="heart d-inline-block ms-auto @(SelectedOffer?.isFavorite == true ? "active" : "")"
                    @onclick="@(async () => await AddRemoveFav(SelectedOffer!))"
                    type="button"
                    data-bs-toggle="button">
                <i class="@(SelectedOffer?.isFavorite == true ? "fa-solid fa-heart" : "fa-regular fa-heart")"></i>
            </button>
        </div>

        <div class="card redeem">
            <h2 class="card-header">@SelectedOffer?.Heading</h2>

            <div class="card-body">
                <h5 class="redeem-desc">@SelectedOffer?.Description</h5>
                <p>Tap Redeem at checkout to display SKU number for cashier.</p>

                @if (!string.IsNullOrWhiteSpace(SelectedOffer?.ThumbnailPath))
                {
                    <div class="card-img" style="background-image: url('@SelectedOffer.ThumbnailPath');"></div>
                }

                <p>
                    This coupon is valid only at @(SelectedOffer?.BusinessName ?? "merchant").
                </p>
            </div>

            <div class="card-footer">
                <a href="#"
                       class="btn btn-primary px-5"
                       data-bs-toggle="modal"
                       data-bs-target="#modalRedeemCode"
                       @onclick:preventDefault>
                    Redeem Offer
                </a>
            </div>
        </div>
    </div>
</div>

<div id="modalRedeemCode" class="modal fade" aria-labelledby="modalRedeemCode" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-body-emphasis">To Redeem this Offer</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Enter code @SelectedOffer?.ConfirmationCode to redeem offer at time of checkout</p>
                <input @bind="Code" class="form-control form-control-lg font-monospace" type="text" minlength="6" maxlength="6" placeholder="Enter Code" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" @onclick="ValidateCode" class="btn btn-primary" data-bs-toggle="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<div id="modalRedeemSuccess" class="modal fade" aria-labelledby="modalRedeemSuccess" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-body-emphasis">Congrats..! Enjoy..!</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>You have successfully redeemed this offer, thank for your shopping local!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="GotoSavingsPage" data-bs-dismiss="modal">SEE YOUR SAVINGS</button>
            </div>
        </div>
    </div>
</div>

<div id="offcanvasNearby" class="offcanvas offcanvas-bottom rounded-4 rounded-bottom-0 px-0 shadow" data-bs-scroll="false" tabindex="-1">
    <div class="offcanvas-body d-flex flex-column justify-content-between">
        <h5 class="text-center mb-3">Offers in @tempRangeDisplay miles</h5>
        <div class="range-wrapper">
            <input id="customRange" class="form-range" type="range" min="1000" max="20000" step="1000" value="@_fixedRadius"
                   @oninput="OnRadiusInput" />
            <output id="rangeValue" for="customRange" aria-hidden="true"></output>
        </div>
        <div class="container d-flex justify-content-between mt-2">
            <button class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Cancel</button>
            <button @onclick="OnRangeSave" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">Save</button>
        </div>
    </div>
</div>
<div class="offcanvas offcanvas-top h-100" tabindex="-1" id="offcanvasFullscreen" aria-labelledby="offcanvasFullscreenLabel">
    <div class="offcanvas-body">
        <div class="search-wrapper">
            <div class="search-bar d-flex align-items-center mb-4">
                <span class="search-icon">
                    <lord-icon src="https://cdn.lordicon.com/wjyqkiew.json"
                               trigger="loop"
                               delay="2000"
                               colors="primary:#121331,secondary:#ff9935"
                               class="top-icon-animated"></lord-icon>
                </span>
                <input type="text"
                       class="form-control border-0"
                       placeholder="Search for Offer / Food / Beauty etc."
                       @bind-value="SearchText"
                       @bind-value:event="oninput"
                       @onkeydown="OnSearchKey" />
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>

            <h5 class="section-title">Popular Categories</h5>
            <div class="row text-center g-3 categories">
                @if (mainCategories?.Any() == true)
                {
                    <div class="owl-carousel offcanvas-categories-slider top-categories">
                        @foreach (var cat in mainCategories)
                        {
                            <CategoryCapsule Category="cat" OnSelected="HandleCategorySelected" />
                        }
                    </div>
                }
                else if (isCategoriesLoading)
                {
                    <div class="col-12 text-muted">Loading categories...</div>
                }
            </div>

            <h5 class="section-title mt-4">Recent Search</h5>
            <ul class="recent-search list-unstyled">
                @if (RecentSearches?.Any() == true)
                {
                    @foreach (var search in RecentSearches)
                    {
                        <li>
                            <a href="#" @onclick="() => OnRecentSearchClicked(search)" @onclick:preventDefault>
                                <i class="fa-solid fa-clock-rotate-left"> <small>@search</small></i>
                            </a>
                            <span class="remove-item" @onclick="() => RemoveSearchItem(search)">
                                <i class="fa-solid fa-xmark"></i>
                            </span>
                        </li>
                    }
                }
            </ul>

            <h5 class="section-title mt-4">Popular Offers</h5>
            <div class="row g-3 offer-cards">
                @if (featuredOffers?.Any() == true)
                {
                    <div class="owl-carousel offers-slider">
                        @foreach (var offer in featuredOffers)
                        {
                            <OfferCard Offer="offer"
                                       OnSelected="HandleOfferSelected"
                                       AddRemoveToFavorite="AddRemoveFav"
                                       isActivePlan="planDetails?.IsActive == true">
                            </OfferCard>
                        }
                    </div>
                }
                else if (isFeaturedOffersLoading)
                {
                    <div class="col-12">
                        <p class="text-muted mb-0">Loading featured offers...</p>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <p class="text-muted mb-0">No featured offers available.</p>
                    </div>
                }
            </div>

            <h5 class="section-title mt-4">Popular Businesses</h5>
            <div class="row g-3 offer-cards">
                @if (featuredOffers?.Any() == true)
                {
                    <div class="owl-carousel offers-slider businesses-slider">
                        @foreach (var offer in featuredOffers.Take(8))
                        {
                            <OfferCard Offer="offer"
                                       OnSelected="HandleOfferSelected"
                                       AddRemoveToFavorite="AddRemoveFav"
                                       isActivePlan="planDetails?.IsActive == true">
                            </OfferCard>
                        }
                    </div>
                }
                else if (isFeaturedOffersLoading)
                {
                    <div class="col-12">
                        <p class="text-muted mb-0">Loading businesses...</p>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <p class="text-muted mb-0">No businesses available.</p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>
@code
{
    #region JS / References

    private IJSObjectReference? _module;
    private DotNetObjectReference<HomeNew>? _self;

    #endregion

    #region Cache Keys

    private const string HomeCategoriesCacheKey = "HomeNew_MainCategories";
    private const string HomeFeaturedOffersCacheKey = "HomeNew_FeaturedOffers";
    private const string HomeFeaturedTopOffersCacheKey = "HomeNew_FeaturedTopOffers";
    private const string HomeRedemptionsCacheKey = "HomeNew_Redemptions";
    private const string HomeFavoritesCacheKey = "HomeNew_Favorites";

    #endregion

    #region Tab Navigation

    private NavTab selectedTab = NavTab.Home;
    private enum NavTab { Home, Directory, Events, Favorites, Map, More }

    private string GetNavClass(NavTab tab) => selectedTab == tab ? "active" : string.Empty;

    private string GetSectionVisibilityClass(NavTab tab) => selectedTab == tab ? string.Empty : "d-none";

    private async Task SelectTabAsync(NavTab tab)
    {
        if (selectedTab == tab)
            return;

        selectedTab = tab;
        await InvokeAsync(StateHasChanged);
        await RefreshActiveTabUiAsync();
    }

    private string GetSelectedTabName()
    {
        return selectedTab switch
        {
            NavTab.Directory => "Directory",
            NavTab.Events => "Events",
            NavTab.Favorites => "Favorites",
            NavTab.Map => "Map",
            NavTab.More => "More",
            _ => "Home"
        };
    }

    #endregion

    #region Collections / Data Sources

    private List<CategoryItem> mainCategories = new();
    private List<RedemptionsItem> topRedemptions = new();
    private List<BusinessOfferItem> featuredOffers = new();
    private List<BusinessOfferItem> featuredOfferstop = new();
    private List<BusinessOfferItem> _favoriteOffers = new();
    private List<EventItem> alleventItems = new();

    private ObservableCollection<RedemptionsItem> redemptions = new();
    public ObservableCollection<RedemptionsItem> Redemptions
    {
        get => redemptions;
        set
        {
            redemptions = value ?? new ObservableCollection<RedemptionsItem>();
            _ = InvokeAsync(StateHasChanged);
        }
    }

    #endregion

    #region Loading / State Flags

    private bool isCategoriesLoading;
    private bool isRedemptionsLoading;
    private bool isFeaturedOffersLoading;
    private bool isEventsLoading;

    private bool IsLoading { get; set; }
    private bool IsLoadingMore { get; set; }
    private bool IsSummaryLoading { get; set; }
    private bool HasMore { get; set; } = true;

    private bool _favBusy;
    private bool _favLoading;
    private bool _favLoadFailed;
    private string? _favError;

    private bool _eventsLoadFailed;
    private string? _eventsError;

    private bool _initialDataLoaded;
    private bool _isInitializingData;
    private bool _jsBootstrapped;

    private bool _categoriesSliderInitialized;
    private bool _offcanvasCategoriesSliderInitialized;
    private bool _offersSliderInitialized;
    private bool _featuredOffersSliderInitialized;
    private bool _redeemedSliderInitialized;

    #endregion

    #region Paging / Filters / Search

    private int Page { get; set; } = 1;
    private int PageSize { get; set; } = 20;
    private DateTime DefaultStartDate { get; set; } = DateTime.Today;

    private string? SearchText;
    private List<string> RecentSearches = new();
    private string? Error { get; set; }

    #endregion

    #region User / Plan / Location

    public AALUser _user { get; set; } = new();

    [Parameter] public double StartLat { get; set; } = 34.197504;
    [Parameter] public double StartLng { get; set; } = -119.177052;

    private PlanDetails? planDetails = new();
    private RedemptionSummaryItem? RedemptionSummary { get; set; }

    public bool IsManageGridVisible = false;
    public string UserSubscriptionStatus { get; set; } = string.Empty;
    private readonly string AccountActivationVerbage = "Gain all the benefits, activate your account now.";
    private string AppVersionAndCopyrightText = string.Empty;

    #endregion

    #region Offer Redeem / Modal State

    private BusinessOfferItem? SelectedOffer = new();
    public string Code { get; set; } = string.Empty;

    #endregion

    #region Map

    private GoogleMap? _map;
    private List<BusinessItem> AllMapBusinessItems = new();
    private List<BusinessItem> CurrentShowingMapOffersItems = new();
    private bool _mapOffersLoading;
    private int _fixedRadius = 5000;
    private string tempRangeDisplay => (_fixedRadius / 1000).ToString() + " miles";

    #endregion

    #region Lifecycle

    protected override async Task OnInitializedAsync()
    {
        App.MyPosition = new Location
        {
            Latitude = StartLat,
            Longitude = StartLng
        };

        CurrentUserService.CurrentUser = await localCache.GetCacheItem<AALUser>(StringConstants.CurrentUser) ?? new AALUser();
        _user = CurrentUserService.CurrentUser ?? new AALUser();

        planDetails = await localCache.GetCacheItem<PlanDetails>(LocalCacheKeys.PlanDetails) ?? new PlanDetails();
        RecentSearches = await localCache.GetCacheItem<List<string>>(LocalCacheKeys.SearchHistory) ?? new List<string>();

        await LoadCachedHomeDataAsync();
        await GetCurrentLocation();

        WeakReferenceMessenger.Default.Register<RefreshFavorites>(this, async (_, _) => await LoadFavoritesAsync());
        WeakReferenceMessenger.Default.Register<UpdatePlaneDetails>(this, async (_, _) => await GetSubscription());
        WeakReferenceMessenger.Default.Register<UserLoggedIn>(this, async (_, _) => await ReloadAfterLoginAsync());

        if (_user?.UserKey > 0)
        {
            await GetSubscription();
            await GetSavingsAsync();
        }
    }

    private async Task ReloadAfterLoginAsync()
    {
        CurrentUserService.CurrentUser = await localCache.GetCacheItem<AALUser>(StringConstants.CurrentUser) ?? new AALUser();
        _user = CurrentUserService.CurrentUser ?? new AALUser();
        planDetails = await localCache.GetCacheItem<PlanDetails>(LocalCacheKeys.PlanDetails) ?? new PlanDetails();

        _initialDataLoaded = false;
        _isInitializingData = false;

        if (_user?.UserKey > 0)
        {
            await GetSubscription();
            await GetSavingsAsync();
        }

        await InitializeHomeDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EnsureJsModuleAsync();
            await BootstrapJsAsync();
            await InitializeHomeDataAsync();
            return;
        }

        // if (_initialDataLoaded)
        // {
        //     await RefreshActiveTabUiAsync();
        // }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            _self?.Dispose();

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch
        {
        }
    }

    #endregion

    #region Initializers

    private async Task EnsureJsModuleAsync()
    {
        if (_module is null)
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./RazorViews/HomeNew.razor.js");

        _self ??= DotNetObjectReference.Create(this);
    }

    private async Task BootstrapJsAsync()
    {
        if (_jsBootstrapped || _module is null)
            return;

        _jsBootstrapped = true;

        await _module.InvokeVoidAsync("initHeroSlider");
        await _module.InvokeVoidAsync("initToggle");
        await _module.InvokeVoidAsync("initBusinessAccordion");
        await _module.InvokeVoidAsync("initHeartAnimation");
    }

    private async Task InitializeHomeDataAsync()
    {
        if (_initialDataLoaded || _isInitializingData || _user?.UserKey <= 0)
            return;

        _isInitializingData = true;

        try
        {
            await Task.WhenAll(
                GetMainCategoriesAsync(),
                GetRedemptionsAsync(),
                GetFeaturedOffersAsync(),
                getEvents(DateTime.Today),
                LoadFavoritesAsync()
            );

            _initialDataLoaded = true;
        }
        finally
        {
            _isInitializingData = false;
            await InvokeAsync(StateHasChanged);
            await RefreshActiveTabUiAsync();
        }
    }

    private async Task RefreshActiveTabUiAsync()
    {
        if (_module is null)
            return;

        try
        {
            if (selectedTab == NavTab.Home)
            {
                if (!_categoriesSliderInitialized)
                {
                    await _module.InvokeVoidAsync("initCategoriesSlider");
                    _categoriesSliderInitialized = true;
                }
                if (!_offcanvasCategoriesSliderInitialized)
                {
                    await _module.InvokeVoidAsync("initOffcanvasCategoriesSlider");
                    _offcanvasCategoriesSliderInitialized = true;
                }
                if (!_offersSliderInitialized)
                {
                    await _module.InvokeVoidAsync("initOffersSlider");
                    _offersSliderInitialized = true;
                }
                if (!_featuredOffersSliderInitialized)
                {
                    await _module.InvokeVoidAsync("initFeaturedOffersSlider");
                    _featuredOffersSliderInitialized = true;
                }
                if (!_redeemedSliderInitialized)
                {
                    await _module.InvokeVoidAsync("initRedeemedSlider");
                    _redeemedSliderInitialized = true;
                }
            }
            else if (selectedTab == NavTab.Directory)
            {
                if (!_offcanvasCategoriesSliderInitialized)
                {
                    await _module.InvokeVoidAsync("initOffcanvasCategoriesSlider");
                    _offcanvasCategoriesSliderInitialized = true;
                }
            }
            else if (selectedTab == NavTab.Map)
            {
                await GetandSetPins();
            }
        }
        catch
        {
        }
    }

    #endregion

    #region Local Cache

    private async Task LoadCachedHomeDataAsync()
    {
        try
        {
            mainCategories = await localCache.GetCacheItem<List<CategoryItem>>(HomeCategoriesCacheKey) ?? new List<CategoryItem>();
            topRedemptions = await localCache.GetCacheItem<List<RedemptionsItem>>(HomeRedemptionsCacheKey) ?? new List<RedemptionsItem>();
            featuredOffers = await localCache.GetCacheItem<List<BusinessOfferItem>>(HomeFeaturedOffersCacheKey) ?? new List<BusinessOfferItem>();
            featuredOfferstop = await localCache.GetCacheItem<List<BusinessOfferItem>>(HomeFeaturedTopOffersCacheKey) ?? new List<BusinessOfferItem>();
            _favoriteOffers = await localCache.GetCacheItem<List<BusinessOfferItem>>(HomeFavoritesCacheKey) ?? new List<BusinessOfferItem>();
        }
        catch
        {
            mainCategories = new();
            topRedemptions = new();
            featuredOffers = new();
            featuredOfferstop = new();
            _favoriteOffers = new();
        }
    }

    #endregion

    #region Location

    private async Task GetCurrentLocation()
    {
        try
        {
            var position = await locationService.GetCurrentLocationAsync();

            App.MyPosition = position ?? new Location
            {
                Latitude = 34.27851,
                Longitude = -119.16
            };
        }
        catch
        {
            App.MyPosition = new Location
            {
                Latitude = 34.27851,
                Longitude = -119.16
            };
        }
    }

    #endregion

    #region API Calls

    private async Task GetSavingsAsync(bool append = false)
    {
        if (_user?.UserKey <= 0)
            return;

        try
        {
            Error = null;

            if (!append)
                IsLoading = true;
            else
                IsLoadingMore = true;

            IsSummaryLoading = !append && Page == 1;

            var redemptionRequest = new GetUserRedemptionRequest(_user.UserKey);

            var redemptionsResp = await apiService.GetUserRedemptions(redemptionRequest);
            var summaryResp = await apiService.GetUserRedemptionSummary(redemptionRequest);

            if (redemptionsResp?.Success == true && redemptionsResp.Data is not null)
            {
                if (append)
                {
                    foreach (var item in redemptionsResp.Data)
                        Redemptions.Add(item);
                }
                else
                {
                    Redemptions = new ObservableCollection<RedemptionsItem>(redemptionsResp.Data);
                }

                HasMore = redemptionsResp.Data.Count >= PageSize;
            }
            else
            {
                if (!append)
                    Redemptions.Clear();

                HasMore = false;
            }

            if (summaryResp?.Success == true && summaryResp.Data is not null)
                RedemptionSummary = summaryResp.Data;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            HasMore = false;
        }
        finally
        {
            IsLoading = false;
            IsLoadingMore = false;
            IsSummaryLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GetMainCategoriesAsync()
    {
        try
        {
            isCategoriesLoading = true;

            var output = await apiService.GetAppMainCategories(new CategoryRequest());

            if (output?.Success == true && output.Data is not null && output.Data.Any())
            {
                var categories = output.Data.ToList();

                if (categories.Count > 0)
                    categories.RemoveAt(0);

                var diningCategory = categories.FirstOrDefault(x => x.Name == "Dining");
                if (diningCategory is not null)
                {
                    categories.Remove(diningCategory);
                    categories.Insert(0, diningCategory);
                }

                mainCategories = categories;
                await localCache.SaveItemInCache(HomeCategoriesCacheKey, mainCategories);
            }
        }
        catch
        {
        }
        finally
        {
            isCategoriesLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GetRedemptionsAsync()
    {
        if (_user?.UserKey <= 0)
            return;

        try
        {
            isRedemptionsLoading = true;

            var redemptionRequest = new GetUserRedemptionRequest(_user.UserKey);
            var redemptionsResp = await apiService.GetUserRedemptions(redemptionRequest);

            topRedemptions =
                redemptionsResp?.Success == true && redemptionsResp.Data is not null
                ? redemptionsResp.Data.Take(10).ToList()
                : new List<RedemptionsItem>();

            await localCache.SaveItemInCache(HomeRedemptionsCacheKey, topRedemptions);
        }
        catch
        {
            topRedemptions = new List<RedemptionsItem>();
        }
        finally
        {
            isRedemptionsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GetFeaturedOffersAsync()
    {
        if (_user?.UserKey <= 0)
            return;

        try
        {
            isFeaturedOffersLoading = true;

            var request = new OffersFeaturedRequest(_user.UserKey.ToString());
            var response = await apiService.GetOffersFeaturedRandom(request);

            var activeOffers =
                response?.Success == true && response.Data is not null
                ? response.Data.Where(x => x.IsActive).ToList()
                : new List<BusinessOfferItem>();

            featuredOffers = activeOffers;

            var request1 = new OffersFeaturedRequest(_user.UserKey.ToString());
            var response1 = await apiService.GetOffersFeaturedRandom(request);

            var activeOffers1 =
                response1?.Success == true && response1.Data is not null
                ? response1.Data.Where(x => x.IsActive).ToList()
                : new List<BusinessOfferItem>();


            featuredOfferstop = activeOffers1;

            await localCache.SaveItemInCache(HomeFeaturedOffersCacheKey, featuredOffers);
            await localCache.SaveItemInCache(HomeFeaturedTopOffersCacheKey, featuredOfferstop);
        }
        catch
        {
            featuredOffers = new List<BusinessOfferItem>();
            featuredOfferstop = new List<BusinessOfferItem>();
        }
        finally
        {
            isFeaturedOffersLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task getEvents(DateTime dateTime)
    {
        _eventsLoadFailed = false;
        _eventsError = null;
        isEventsLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var eventRequest = new EventRequest(_user.UserKey.ToString());
            var result = await apiService.GetEvents(eventRequest);

            if (result.Success)
            {
                alleventItems = result.Data.OrderBy(o => o.EventStart).ToList();
            }
            else
            {
                _eventsLoadFailed = true;
                _eventsError = result.Message;
                alleventItems = new List<EventItem>();
            }
        }
        catch (Exception ex)
        {
            _eventsLoadFailed = true;
            _eventsError = ex.Message;
            alleventItems = new List<EventItem>();
        }
        finally
        {
            isEventsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task RetryEventsAsync() => getEvents(DateTime.Today);

    private async Task GetSubscription()
    {
        if (_user?.UserKey <= 0)
            return;

        try
        {
            var request = new UserSubscriptionPlanRequest(_user.UserKey);
            var output = await apiService.AppUsersActiveSubscription(request);

            if (output?.Success == true && output.Data is not null && output.Data.Count > 0)
            {
                planDetails = output.Data[0];
                await localCache.SaveItemInCache(LocalCacheKeys.PlanDetails, planDetails);
                Preferences.Default.Set(StringConstants.IsPlanActive, planDetails.IsActive);

                if (planDetails.IsActive)
                {
                    UserSubscriptionStatus = $"Current Plan is {planDetails.PlanName}";
                    IsManageGridVisible = true;
                }
                else
                {
                    IsManageGridVisible = false;
                    UserSubscriptionStatus = AccountActivationVerbage;
                }
            }
            else
            {
                IsManageGridVisible = false;
                UserSubscriptionStatus = AccountActivationVerbage;
            }
        }
        catch
        {
            IsManageGridVisible = false;
            UserSubscriptionStatus = AccountActivationVerbage;
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ValidateCode()
    {
        if (_user?.UserKey <= 0 || SelectedOffer is null)
            return;

        var request = new RedeemOfferRequest(
            _user.UserKey.ToString(),
            SelectedOffer.BusinessOffersKey.ToString(),
            Code);

        var output = await apiService.RedeemOffer(request);

        if (output?.Success == true && _module is not null)
            await _module.InvokeVoidAsync("showHideModal", true);
    }

    #endregion

    #region Search / Input Handlers

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await JS.InvokeVoidAsync("eval", "document.activeElement.blur()");
            await DoSearchAsync(SearchText);
        }
    }

    private async Task OnRecentSearchClicked(string searchTerm)
    {
        SearchText = searchTerm;
