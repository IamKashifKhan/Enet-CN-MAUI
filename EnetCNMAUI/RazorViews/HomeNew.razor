    #endregion

    #region Search / Input Handlers

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await JS.InvokeVoidAsync("eval", "document.activeElement.blur()");
            await DoSearchAsync(SearchText);
        }
    }

    private async Task OnRecentSearchClicked(string searchTerm)
    {
        SearchText = searchTerm;
        await DoSearchAsync(searchTerm);
    }

    private async Task RemoveSearchItem(string searchTerm)
    {
        RecentSearches.Remove(searchTerm);
        await localCache.SaveItemInCache(LocalCacheKeys.SearchHistory, RecentSearches);
        StateHasChanged();
    }

    private async Task DoSearchAsync(string? q)
    {
        if (string.IsNullOrWhiteSpace(q))
            return;

        if (!RecentSearches.Contains(q))
        {
            RecentSearches.Insert(0, q);

            if (RecentSearches.Count > 4)
                RecentSearches = RecentSearches.Take(4).ToList();

            await localCache.SaveItemInCache(LocalCacheKeys.SearchHistory, RecentSearches);
        }

        var route = RouteHelper.BuildRoute(
            nameof(BusinessesPage),
            new Dictionary<string, string>
            {
                { "CategoryId", $"Search,{q}" }
            });

        await Shell.Current.GoToAsync(route);
    }

    #endregion

    #region Offer / Category Actions

    private async Task HandleCategorySelected(CategoryItem categoryItem)
    {
        if (categoryItem.Category_Sub_Key == CategoryConstants.CategorySubKeyPerks)
        {
            await Launcher.Default.OpenAsync("https://allaboutlocal.benefithub.com/");
            return;
        }

        var route = RouteHelper.BuildRoute(
            nameof(BusinessesPage),
            new Dictionary<string, string>
            {
                { "CategoryId", $"{categoryItem.Category_Sub_Key},{categoryItem.Name}" }
