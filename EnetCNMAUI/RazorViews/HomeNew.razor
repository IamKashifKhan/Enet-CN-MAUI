@page "/homenew"
@implements IAsyncDisposable

@inject IJSRuntime JS
@inject ICNApiService apiService
@inject ILocalCache localCache

@using EnetCNMAUI.ApiService.Requests.MVC
@using EnetCNMAUI.Domain.Models.MVC
@using System.Collections.ObjectModel
@using EnetCNMAUI.Views

<div class="offcanvas offcanvas-top h-100" tabindex="-1" id="offcanvasFullscreen" aria-labelledby="offcanvasFullscreenLabel">
    <div class="offcanvas-body">
        <div class="search-wrapper">

            <!-- Search Bar -->
            <div class="search-bar d-flex align-items-center mb-4">
                <span class="search-icon">
                    <lord-icon src="https://cdn.lordicon.com/wjyqkiew.json"
                               trigger="loop"
                               delay="2000"
                               colors="primary:#121331,secondary:#ff9935"
                               class="top-icon-animated"></lord-icon>
                </span>
                <input type="text" 
                       class="form-control border-0" 
                       placeholder="Search for Offer / Food / Beauty etc."
                       @bind-value="SearchText"
                       @bind-value:event="oninput"
                       @onkeydown="OnSearchKey"
                       @onkeydown:preventDefault />
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>

            <!-- Popular Categories -->
            <h5 class="section-title">Popular Categories</h5>
            <div class="row text-center g-3 categories">
                @if (mainCategories != null && mainCategories.Any())
                {
                    <div class="owl-carousel offcanvas-categories-slider top-categories">
                        @foreach (var cat in mainCategories)
                        {
                            <CategoryCapsule Category="cat" OnSelected="HandleCategorySelected" />
                        }
                    </div>
                }
                else if (isCategoriesLoading)
                {
                    <div class="col-12 text-muted">Loading categories...</div>
                }
            </div>

            <!-- Recent Search -->
            <h5 class="section-title mt-4">Recent Search</h5>
            <ul class="recent-search list-unstyled">
                <li><a href="#"><i class="fa-solid fa-clock-rotate-left"> <small>Plumber</small></i></a><span class="remove-item"><i class="fa-solid fa-xmark"></i></span></li>
                <li><a href="#"><i class="fa-solid fa-clock-rotate-left"> <small>Burger</small></i></a><span class="remove-item"><i class="fa-solid fa-xmark"></i></span></li>
                <li><a href="#"><i class="fa-solid fa-clock-rotate-left"> <small>Pet Food</small></i></a><span class="remove-item"><i class="fa-solid fa-xmark"></i></span></li>
                <li><a href="#"><i class="fa-solid fa-clock-rotate-left"> <small>Movie</small></i></a><span class="remove-item"><i class="fa-solid fa-xmark"></i></span></li>
            </ul>

            <!-- Popular Offers -->
            <h5 class="section-title mt-4">Popular Offers</h5>
            <div class="row g-3 offer-cards">
                @if (featuredOffers != null && featuredOffers.Any())
                {
                    <div class="owl-carousel offers-slider">
                        @foreach (var offer in featuredOffers)
                        {
                            <div class="item">
                                <div class="card custom-card">
                                    <a href="#"
                                           class="hover-underline-animation"
                                           @onclick="async () => await OpenFeaturedOfferAsync(offer)"
                                           @onclick:preventDefault>
                                        <img src="@GetOfferImage(offer)" class="card-img-top" alt="@offer.Heading">
                                        <div class="card-body">
                                            <h6>@GetOfferHeading(offer)</h6>
                                            <small>@GetOfferSubTitle(offer)</small>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (isFeaturedOffersLoading)
                {
                    <div class="col-12">
                        <p class="text-muted mb-0">Loading featured offers...</p>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <p class="text-muted mb-0">No featured offers available.</p>
                    </div>
                }
            </div>

            <!-- Popular Business -->
            <h5 class="section-title mt-4">Popular Businesses</h5>
            <div class="row g-3 offer-cards">
                @if (featuredOffers != null && featuredOffers.Any())
                {
                    <div class="owl-carousel offers-slider businesses-slider">
                        @foreach (var offer in featuredOffers.Take(8))
                        {
                            <div class="item">
                                <div class="card custom-card">
                                    <a href="#"
                                           class="hover-underline-animation"
                                           @onclick="async () => await OpenFeaturedOfferAsync(offer)"
                                           @onclick:preventDefault>
                                        <img src="@GetBusinessImage(offer)" class="card-img-top" alt="@offer.BusinessName">
                                        <div class="card-body">
                                            <h6>@(string.IsNullOrWhiteSpace(offer.BusinessName) ? "Business" : offer.BusinessName)</h6>
                                            <small>@GetOfferHeading(offer)</small>
                                        </div>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (isFeaturedOffersLoading)
                {
                    <div class="col-12">
                        <p class="text-muted mb-0">Loading businesses...</p>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <p class="text-muted mb-0">No businesses available.</p>
                    </div>
                }
            </div>

            <!-- Nearby Range -->
            <h5 class="section-title mt-4">Nearby Range</h5>
            <div class="range-wrapper">
                <div class="d-flex justify-content-between">
                    <span>0.5mi</span>
                    <span>10mi</span>
                </div>

                <input type="range" min="0" max="10" step="0.1" value="3.5"
                       class="form-range custom-range" id="distanceRange">

                <div class="text-center mt-2">
                    <span id="rangeValue">3.5</span>mi
                </div>
            </div>

            <!-- Button -->
            <div class="text-center mt-4">
                <button class="btn filter-btn">Filter Now</button>
            </div>

        </div>
    </div>
</div>

