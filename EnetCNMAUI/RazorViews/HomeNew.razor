        RecentSearches = await localCache.GetCacheItem<List<string>>(LocalCacheKeys.SearchHistory)
                         ?? new List<string>();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./RazorViews/HomeNew.razor.js");

        await _module.InvokeVoidAsync("initHeroSlider");
        await _module.InvokeVoidAsync("initToggle");
        await _module.InvokeVoidAsync("initBusinessAccordion");
        await _module.InvokeVoidAsync("initHeartAnimation");

        await GetMainCategoriesAsync();
        await GetRedemptionsAsync();
        await GetFeaturedOffersAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module != null)
                await _module.DisposeAsync();
        }
        catch
        {
        }
    }

    #endregion

    #region Location

    private async Task GetCurrentLocation()
    {
        var position = await locationService.GetCurrentLocationAsync();

        if (position != null)
        {
            App.MyPosition = position;
        }
        else
        {
            App.MyPosition = new Location
            {
                Latitude = 34.27851,
                Longitude = -119.16
            };
        }

        Console.WriteLine($"Current location: {App.MyPosition.Latitude}, {App.MyPosition.Longitude}");
    }

    #endregion

    #region API Calls

    private async Task GetSavingsAsync(bool append = false)
    {
        try
        {
            Error = null;

            if (!append)
                IsLoading = true;
            else
                IsLoadingMore = true;

            IsSummaryLoading = !append && Page == 1;

            var redemptionRequest = new GetUserRedemptionRequest(App.CurrentUser.UserKey);

            var redemptionsResp = await apiService.GetUserRedemptions(redemptionRequest);
            var summaryResp = await apiService.GetUserRedemptionSummary(redemptionRequest);

            if (redemptionsResp?.Success == true && redemptionsResp.Data is not null)
            {
                if (append)
                {
                    foreach (var item in redemptionsResp.Data)
                        Redemptions.Add(item);
                }
                else
                {
                    Redemptions = new ObservableCollection<RedemptionsItem>(redemptionsResp.Data);
                }

                HasMore = redemptionsResp.Data.Count >= PageSize;
            }
            else
            {
                if (!append)
                    Redemptions.Clear();

                HasMore = false;
            }

            if (summaryResp?.Success == true && summaryResp.Data is not null)
            {
                RedemptionSummary = summaryResp.Data;
            }
        }
        catch (Exception ex)
        {
            Error = ex.Message;
            HasMore = false;
        }
        finally
        {
            IsLoading = false;
            IsLoadingMore = false;
            IsSummaryLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GetMainCategoriesAsync()
    {
        try
        {
            isCategoriesLoading = true;

            var categoryRequest = new CategoryRequest();
            var output = await apiService.GetAppMainCategories(categoryRequest);

            if (output?.Success == true && output.Data is not null && output.Data.Any())
            {
                var categories = output.Data.ToList();

                if (categories.Count > 0)
                    categories.RemoveAt(0);

                var diningCategory = categories.FirstOrDefault(x => x.Name == "Dining");
                if (diningCategory != null)
                {
                    categories.Remove(diningCategory);
                    categories.Insert(0, diningCategory);
                }

                mainCategories = categories;

                await InvokeAsync(StateHasChanged);

                if (_module != null)
                {
                    await _module.InvokeVoidAsync("initCategoriesSlider");
                    await _module.InvokeVoidAsync("initOffcanvasCategoriesSlider");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching main categories: {ex.Message}");
        }
        finally
        {
            isCategoriesLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GetRedemptionsAsync()
    {
        try
        {
            isRedemptionsLoading = true;

            var redemptionRequest = new GetUserRedemptionRequest(App.CurrentUser.UserKey);
            var redemptionsResp = await apiService.GetUserRedemptions(redemptionRequest);

            if (redemptionsResp?.Success == true && redemptionsResp.Data is not null)
            {
                topRedemptions = redemptionsResp.Data.Take(10).ToList();

                await InvokeAsync(StateHasChanged);

                if (_module != null)
                    await _module.InvokeVoidAsync("initRedeemedSlider");
            }
            else
            {
                topRedemptions = new List<RedemptionsItem>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching redemptions: {ex.Message}");
            topRedemptions = new List<RedemptionsItem>();
        }
        finally
        {
            isRedemptionsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GetFeaturedOffersAsync()
    {
        try
        {
            isFeaturedOffersLoading = true;

            var request = new OffersFeaturedRequest(App.CurrentUser.UserKey.ToString());

            var response = await apiService.GetOffersFeaturedRandom(request);

            if (response?.Success == true && response.Data is not null)
            {
                featuredOffers = response.Data
                    .Where(x => x.IsActive)
                    .ToList();

                await InvokeAsync(StateHasChanged);

                if (_module != null)
                {
                    await _module.InvokeVoidAsync("initOffersSlider");
                    await _module.InvokeVoidAsync("initFeaturedOffersSlider");
                    await _module.InvokeVoidAsync("initRedeemedSlider");
                }
            }

            var responsetop = await apiService.GetOffersFeaturedRandom(request);

            if (responsetop?.Success == true && responsetop.Data is not null)
            {
                featuredOfferstop = responsetop.Data
                    .Where(x => x.IsActive)
                    .ToList();

                await InvokeAsync(StateHasChanged);

                if (_module != null)
                {
                    await _module.InvokeVoidAsync("initOffersSlider");
                    await _module.InvokeVoidAsync("initFeaturedOffersSlider");
                    await _module.InvokeVoidAsync("initRedeemedSlider");
                }
            }
            else
            {
                featuredOfferstop = new List<BusinessOfferItem>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching featured offers: {ex.Message}");
            featuredOffers = new List<BusinessOfferItem>();
        }
        finally
        {
            isFeaturedOffersLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GetSubscription()
    {
        try
        {
           
            var userSubscriptionPlanRequest = new UserSubscriptionPlanRequest(App.CurrentUser.UserKey);
            var output = await apiService.AppUsersActiveSubscription(userSubscriptionPlanRequest);

            if (output.Success && output.Data != null && output.Data.Count > 0)
            {
                planDetails = output.Data[0];
                await localCache.SaveItemInCache<PlanDetails>(LocalCacheKeys.PlanDetails, output.Data[0]);
                Preferences.Default.Set(StringConstants.IsPlanActive, output.Data[0].IsActive);

                if (planDetails.IsActive)
                {
                    UserSubscriptionStatus = $"Current Plan is {planDetails.PlanName}";
                    IsManageGridVisible = true;
                }
                else
                {
                    IsManageGridVisible = false;
                    UserSubscriptionStatus = AccountActivationVerbage;
                }
            }
            else
            {
                UserSubscriptionStatus = AccountActivationVerbage;
            }
        }
        catch (Exception)
        {
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task ValidateCode()
    {
        var redeedmOfferRequest = new RedeemOfferRequest(
            App.CurrentUser.UserKey.ToString(),
            SelectedOffer.BusinessOffersKey.ToString(),
            Code);

        var output = await apiService.RedeemOffer(redeedmOfferRequest);

        if (output.Success)
        {
            if (_module != null)
                await _module.InvokeVoidAsync("showHideModal", true);
        }
