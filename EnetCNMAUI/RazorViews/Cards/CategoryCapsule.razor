<div class="cat-item">
    <a href="#" class="hover-underline-animation center"
           @onclick="@(async () => await OnSelected.InvokeAsync(Category))"
           @onclick:preventDefault>
        <img src="@GetCategoryIcon(Category)" />
        <p>@Category.Name</p>
    </a>
</div>

@code {

    [Parameter, EditorRequired] public CategoryItem Category { get; set; } = null!;
    [Parameter, EditorRequired] public EventCallback<CategoryItem> OnSelected { get; set; }


    private  string GetCategoryIcon(CategoryItem cat)
    {
        if (cat.Name == CategoryConstants.Cities) return "images/icon_home.svg";
        if (cat.Name == CategoryConstants.EatAndTreat) return "images/icon_eat.svg";
        if (cat.Name == CategoryConstants.Dining) return "images/icon_eat.svg";
        if (cat.Name == CategoryConstants.WineAndSpirits) return "images/icon_drink.svg";
        if (cat.Name == CategoryConstants.HealthAndFitness) return "images/icon_health.svg";
        if (cat.Name == CategoryConstants.Automotive) return "images/icon_automotive.svg";
        if (cat.Name == CategoryConstants.Shops) return "images/icon_shops.svg";
        if (cat.Name == CategoryConstants.Pets) return "images/icon_pet.svg";
        if (cat.Name == CategoryConstants.BeautyAndSpas) return "images/icon_care.svg";
        if (cat.Name == CategoryConstants.Entertainment) return "images/icon_entertainment.svg";
        if (cat.Name == CategoryConstants.Kids) return "images/icon_kids.svg";
        if (cat.Name == CategoryConstants.BusinessServices) return "images/icon_business.svg";
        if (cat.Name == CategoryConstants.Home) return "images/icon_home.svg";
        if (cat.Name == CategoryConstants.Bogo) return "images/icon_bogo.svg";
        if (cat.Category_Sub_Key == CategoryConstants.CategorySubKeyPerks) return "images/icon_perk.svg";

        return "img/shop.svg"; // fallback
    }

}
